{%CLASSGROUP 'Vcl.Controls.TControl'}

{$R *.dfm}

procedure TdmConexoes.CarregarConfiguracoes;
var
  INI: TIniFile;
begin
  INI := TIniFile.Create(ExtractFilePath(Application.ExeName) + 'config.ini');
  try
    cfg_Empresa  := INI.ReadString('Empresa',    'Nome',      'Minha Empresa');
    cfg_Endereco := INI.ReadString('Empresa',    'Endereco',  'Rua Exemplo, 123');
    cfg_Telefone := INI.ReadString('Empresa',    'Telefone',  '(00) 00000-0000');
    cfg_Porta    := INI.ReadString('Impressora', 'Porta',     'COM1');
    cfg_Modelo   := INI.ReadInteger('Impressora', 'Modelo', 0);
  finally
    INI.Free;
  end;
end;

function TdmConexoes.ModeloImpressora: Integer;
begin
  Result := cfg_Modelo;
end;

function TdmConexoes.PortaImpressora: string;
begin
  Result := cfg_Porta;
end;

function TdmConexoes.NomeEmpresa: string;
