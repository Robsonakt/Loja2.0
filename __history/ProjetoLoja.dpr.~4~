program ProjetoLoja;

uses
  Vcl.Forms,
  untInicial in 'untInicial.pas' {FormularioPrincipal},
  dmconexao in 'dmconexao.pas' {dmConexoes: TDataModule},
  untCadastroProd in 'untCadastroProd.pas' {frmCadastroProdutos},
  untVenda in 'untVenda.pas' {Form3},
  untConsultaVendas in 'untConsultaVendas.pas' {Form4},
  UntRelatorioVenda in 'UntRelatorioVenda.pas' {Form5},
  untRelatorioProd in 'untRelatorioProd.pas' {CadastroProduto};

{$R *.res}

begin
  Application.Initialize;
  Application.MainFormOnTaskbar := True;
  Application.CreateForm(TFormularioPrincipal, FormularioPrincipal);
  Application.CreateForm(TdmConexoes, dmConexoes);
  Application.CreateForm(TfrmCadastroProdutos, frmCadastroProdutos);
  Application.CreateForm(TForm3, Form3);
  Application.CreateForm(TForm4, Form4);
  Application.CreateForm(TForm5, Form5);
  Application.CreateForm(TCadastroProduto, CadastroProduto);
  Application.Run;
end.
