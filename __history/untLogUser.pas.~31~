unit untLogUser;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.StdCtrls,
  Data.DB, dmconexao,Vcl.DBCtrls;

type
  TfrmLogin = class(TForm)
    pnPrincipal: TPanel;
    Label1: TLabel;
    Label2: TLabel;
    edtSenha: TEdit;
    btnOk: TButton;
    btnCancelar: TButton;
    cbUsuario: TComboBox;
    procedure FormCreate(Sender: TObject);
    procedure btnOkClick(Sender: TObject);
    procedure btnCancelarClick(Sender: TObject);
  private
  public
  end;

var
  frmLogin: TfrmLogin;

implementation

{$R *.dfm}

procedure TfrmLogin.FormCreate(Sender: TObject);
begin
  cbUsuario.Clear;

  dmConexoes.qrUsuario.Close;
  dmConexoes.qrUsuario.SQL.Clear;
  dmConexoes.qrUsuario.SQL.Add(
    'SELECT ID, Usuario FROM Usuarios ORDER BY Usuario'
  );
  dmConexoes.qrUsuario.Open;

  while not dmConexoes.qrUsuario.Eof do
  begin
    cbUsuario.Items.AddObject(
      dmConexoes.qrUsuario.FieldByName('Usuario').AsString,
      TObject(dmConexoes.qrUsuario.FieldByName('ID').AsInteger)
    );
    dmConexoes.qrUsuario.Next;
  end;

  if cbUsuario.Items.Count > 0 then
    cbUsuario.ItemIndex := 0;
end;

procedure TfrmLogin.btnOkClick(Sender: TObject);
var
  UsuarioID: Integer;
begin
  if cbUsuario.ItemIndex = -1 then
  begin
    ShowMessage('Selecione um usuário.');
    Exit;
  end;

  if Trim(edtSenha.Text) = '' then
  begin
    ShowMessage('Informe a senha.');
    edtSenha.SetFocus;
    Exit;
  end;

  UsuarioID := Integer(cbUsuario.Items.Objects[cbUsuario.ItemIndex]);

  dmConexoes.qrUsuario.Close;
  dmConexoes.qrUsuario.SQL.Clear;
  dmConexoes.qrUsuario.SQL.Add(
    'SELECT ID FROM Usuarios WHERE ID = :ID AND Senha = :Senha'
  );
  dmConexoes.qrUsuario.Parameters.ParamByName('ID').Value := UsuarioID;
  dmConexoes.qrUsuario.Parameters.ParamByName('Senha').Value := edtSenha.Text;
  dmConexoes.qrUsuario.Open;

  if not dmConexoes.qrUsuario.IsEmpty then
  begin
    ModalResult := mrOk; // login aceito
  end
  else
  begin
    ShowMessage('Senha incorreta.');
    edtSenha.Clear;
    edtSenha.SetFocus;
  end;
end;

procedure TfrmLogin.btnCancelarClick(Sender: TObject);
begin
  Application.Terminate;
end;

end.

