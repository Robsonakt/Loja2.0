// -------------------------------------------------------
procedure TfrmCadastroProdutos.FormShow(Sender: TObject);
begin
  with dmConexoes do
  begin
    qrEstoque.Close;
    qrEstoque.SQL.Clear;
    qrEstoque.SQL.Add('SELECT * FROM [LojaNova].[dbo].[PRODUTOS]');
    qrEstoque.Open;
    qrEstoque.First;
  end;
end;

