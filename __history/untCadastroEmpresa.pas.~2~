procedure TfrmCadastroEmpresa.ConectarBanco;
begin
  try
    // Ajuste Server, Database, User_Name e Password conforme seu ambiente
    FDConnection1.Params.Clear;
    FDConnection1.Params.Add('DriverID=MSSQL');
    FDConnection1.Params.Add('Server=SEU_SERVIDOR');      // ex: MAQUINA\SQLEXPRESS
    FDConnection1.Params.Add('Database=SEU_BANCO');
    FDConnection1.Params.Add('User_Name=sa');
    FDConnection1.Params.Add('Password=SUA_SENHA');
    FDConnection1.Params.Add('OSAuthent=No');             // True para Windows Auth
    FDConnection1.LoginPrompt := False;
    FDConnection1.Connected := True;
  except
    on E: Exception do
      ShowMessage('Erro ao conectar ao banco de dados:' + sLineBreak + E.Message);
  end;
end;

// ============================================================
//  CRUD — SQL SERVER
// ============================================================

procedure TfrmCadastroEmpresa.CarregarDados(ACodigo: Integer);
begin
  try
    qryEmpresa.Close;
    qryEmpresa.SQL.Text :=
      'SELECT * FROM EMPRESA WHERE ID_EMPRESA = :pCodigo';
    qryEmpresa.ParamByName('pCodigo').AsInteger := ACodigo;
    qryEmpresa.Open;

    if qryEmpresa.IsEmpty then
    begin
      ShowMessage('Empresa não encontrada.');
      Exit;
    end;

    FCodigoAtual := ACodigo;

    edtCodigo.Text      := qryEmpresa.FieldByName('ID_EMPRESA').AsString;
    edtRazaoSocial.Text := qryEmpresa.FieldByName('RAZAO_SOCIAL').AsString;
    edtNomeFantasia.Text:= qryEmpresa.FieldByName('NOME_FANTASIA').AsString;
    edtCNPJ.Text        := FormatarCNPJ(qryEmpresa.FieldByName('CNPJ').AsString);
    edtIE.Text          := qryEmpresa.FieldByName('INSC_ESTADUAL').AsString;
    edtIM.Text          := qryEmpresa.FieldByName('INSC_MUNICIPAL').AsString;
    edtCEP.Text         := FormatarCEP(qryEmpresa.FieldByName('CEP').AsString);
    edtLogradouro.Text  := qryEmpresa.FieldByName('LOGRADOURO').AsString;
    edtNumero.Text      := qryEmpresa.FieldByName('NUMERO').AsString;
    edtComplemento.Text := qryEmpresa.FieldByName('COMPLEMENTO').AsString;
    edtBairro.Text      := qryEmpresa.FieldByName('BAIRRO').AsString;
    edtCidade.Text      := qryEmpresa.FieldByName('CIDADE').AsString;
    edtUF.Text          := qryEmpresa.FieldByName('UF').AsString;
    edtTelefone.Text    := qryEmpresa.FieldByName('TELEFONE').AsString;
    edtCelular.Text     := qryEmpresa.FieldByName('CELULAR').AsString;
    edtEmail.Text       := qryEmpresa.FieldByName('EMAIL').AsString;
    edtSite.Text        := qryEmpresa.FieldByName('SITE').AsString;
    edtCNAE.Text        := qryEmpresa.FieldByName('CNAE').AsString;
    edtAtividade.Text   := qryEmpresa.FieldByName('ATIVIDADE').AsString;
    edtSuframa.Text     := qryEmpresa.FieldByName('SUFRAMA').AsString;
    memObservacoes.Text := qryEmpresa.FieldByName('OBSERVACOES').AsString;

    cboRegime.ItemIndex  := qryEmpresa.FieldByName('REGIME_TRIBUTARIO').AsInteger;
    cboSituacao.ItemIndex:= qryEmpresa.FieldByName('SITUACAO').AsInteger;

    HabilitarEdicao(True);
    FModoEdicao := True;

  except
    on E: Exception do
      ShowMessage('Erro ao carregar empresa:' + sLineBreak + E.Message);
  end;
end;

procedure TfrmCadastroEmpresa.btnGravarClick(Sender: TObject);
var
  sSQL: string;
begin
  if not ValidarCampos then Exit;

  try
    // INSERT ou UPDATE
    if FCodigoAtual = 0 then
    begin
      FCodigoAtual := ProximoCodigo;
      sSQL :=
        'INSERT INTO EMPRESA (' +
        '  ID_EMPRESA, RAZAO_SOCIAL, NOME_FANTASIA, CNPJ,' +
        '  INSC_ESTADUAL, INSC_MUNICIPAL, REGIME_TRIBUTARIO,' +
        '  CEP, LOGRADOURO, NUMERO, COMPLEMENTO, BAIRRO, CIDADE, UF,' +
        '  TELEFONE, CELULAR, EMAIL, SITE,' +
        '  CNAE, ATIVIDADE, SUFRAMA, OBSERVACOES, SITUACAO' +
        ') VALUES (' +
        '  :pID, :pRazao, :pFantasia, :pCNPJ,' +
        '  :pIE, :pIM, :pRegime,' +
        '  :pCEP, :pLogr, :pNum, :pCompl, :pBairro, :pCidade, :pUF,' +
        '  :pTel, :pCel, :pEmail, :pSite,' +
        '  :pCNAE, :pAtiv, :pSuframa, :pObs, :pSit' +
        ')';
    end
    else
    begin
      sSQL :=
        'UPDATE EMPRESA SET' +
        '  RAZAO_SOCIAL      = :pRazao,' +
        '  NOME_FANTASIA     = :pFantasia,' +
        '  CNPJ              = :pCNPJ,' +
        '  INSC_ESTADUAL     = :pIE,' +
        '  INSC_MUNICIPAL    = :pIM,' +
        '  REGIME_TRIBUTARIO = :pRegime,' +
        '  CEP               = :pCEP,' +
        '  LOGRADOURO        = :pLogr,' +
        '  NUMERO            = :pNum,' +
        '  COMPLEMENTO       = :pCompl,' +
        '  BAIRRO            = :pBairro,' +
        '  CIDADE            = :pCidade,' +
        '  UF                = :pUF,' +
        '  TELEFONE          = :pTel,' +
        '  CELULAR           = :pCel,' +
        '  EMAIL             = :pEmail,' +
        '  SITE              = :pSite,' +
        '  CNAE              = :pCNAE,' +
        '  ATIVIDADE         = :pAtiv,' +
        '  SUFRAMA           = :pSuframa,' +
        '  OBSERVACOES       = :pObs,' +
        '  SITUACAO          = :pSit' +
        ' WHERE ID_EMPRESA = :pID';
    end;

    qryEmpresa.Close;
    qryEmpresa.SQL.Text := sSQL;

    qryEmpresa.ParamByName('pID').AsInteger      := FCodigoAtual;
    qryEmpresa.ParamByName('pRazao').AsString    := Trim(edtRazaoSocial.Text);
    qryEmpresa.ParamByName('pFantasia').AsString := Trim(edtNomeFantasia.Text);
    qryEmpresa.ParamByName('pCNPJ').AsString     := SoNumeros(edtCNPJ.Text);
    qryEmpresa.ParamByName('pIE').AsString       := Trim(edtIE.Text);
    qryEmpresa.ParamByName('pIM').AsString       := Trim(edtIM.Text);
    qryEmpresa.ParamByName('pRegime').AsInteger  := cboRegime.ItemIndex;
    qryEmpresa.ParamByName('pCEP').AsString      := SoNumeros(edtCEP.Text);
    qryEmpresa.ParamByName('pLogr').AsString     := Trim(edtLogradouro.Text);
    qryEmpresa.ParamByName('pNum').AsString      := Trim(edtNumero.Text);
    qryEmpresa.ParamByName('pCompl').AsString    := Trim(edtComplemento.Text);
    qryEmpresa.ParamByName('pBairro').AsString   := Trim(edtBairro.Text);
    qryEmpresa.ParamByName('pCidade').AsString   := Trim(edtCidade.Text);
    qryEmpresa.ParamByName('pUF').AsString       := Trim(edtUF.Text);
    qryEmpresa.ParamByName('pTel').AsString      := SoNumeros(edtTelefone.Text);
    qryEmpresa.ParamByName('pCel').AsString      := SoNumeros(edtCelular.Text);
    qryEmpresa.ParamByName('pEmail').AsString    := Trim(edtEmail.Text);
    qryEmpresa.ParamByName('pSite').AsString     := Trim(edtSite.Text);
    qryEmpresa.ParamByName('pCNAE').AsString     := Trim(edtCNAE.Text);
    qryEmpresa.ParamByName('pAtiv').AsString     := Trim(edtAtividade.Text);
    qryEmpresa.ParamByName('pSuframa').AsString  := Trim(edtSuframa.Text);
    qryEmpresa.ParamByName('pObs').AsString      := Trim(memObservacoes.Text);
    qryEmpresa.ParamByName('pSit').AsInteger     := cboSituacao.ItemIndex;

    qryEmpresa.ExecSQL;

    edtCodigo.Text := IntToStr(FCodigoAtual);
    FModoEdicao := True;
    ShowMessage('Empresa gravada com sucesso!');

  except
    on E: Exception do
      ShowMessage('Erro ao gravar empresa:' + sLineBreak + E.Message);
  end;
end;

procedure TfrmCadastroEmpresa.btnExcluirClick(Sender: TObject);
begin
  if FCodigoAtual = 0 then
  begin
    ShowMessage('Nenhuma empresa selecionada para exclusão.');
    Exit;
  end;

  if MessageDlg('Confirma a exclusão desta empresa?',
    mtConfirmation, [mbYes, mbNo], 0) <> mrYes then Exit;

  try
    qryEmpresa.Close;
    qryEmpresa.SQL.Text :=
      'DELETE FROM EMPRESA WHERE ID_EMPRESA = :pCodigo';
    qryEmpresa.ParamByName('pCodigo').AsInteger := FCodigoAtual;
    qryEmpresa.ExecSQL;

    ShowMessage('Empresa excluída com sucesso!');
    LimparCampos;
    HabilitarEdicao(False);
    FModoEdicao  := False;
    FCodigoAtual := 0;

  except
    on E: Exception do
      ShowMessage('Erro ao excluir empresa:' + sLineBreak + E.Message);
  end;
end;

procedure TfrmCadastroEmpresa.btnNovoClick(Sender: TObject);
begin
  LimparCampos;
  HabilitarEdicao(True);
  FModoEdicao  := False;
  FCodigoAtual := 0;
  edtRazaoSocial.SetFocus;
end;

procedure TfrmCadastroEmpresa.btnCancelarClick(Sender: TObject);
begin
  if FCodigoAtual > 0 then
    CarregarDados(FCodigoAtual)
  else
    LimparCampos;

  HabilitarEdicao(False);
  FModoEdicao := False;
end;

procedure TfrmCadastroEmpresa.btnLimparClick(Sender: TObject);
begin
  if MessageDlg('Deseja limpar todos os campos?',
    mtConfirmation, [mbYes, mbNo], 0) = mrYes then
    LimparCampos;
end;

